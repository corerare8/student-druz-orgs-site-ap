<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} — Студенческие объединения</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header class="site-header">
    <a href="/" class="logo" id="home-link"><img src="/images/site-logo.png" alt="СТУД" class="logo-icon">СТУД+Друзья</a>
  </header>

  <main>
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <p>Сделано студентами для студентов ✦ {{ currentYear }}</p>
  </footer>

  <script>
    document.getElementById('home-link').addEventListener('click', function (e) {
      var onHomePage = window.location.pathname === '/' || window.location.pathname === '/index.html';
      if (onHomePage) {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    });
  </script>
</body>
</html>
